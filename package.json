{
  "name": "dsh-plugin-internet-meme",
  "version": "0.4.4",
  "description": "Zero-intrusion meme danmaku subtitles for the DeepSeek Harness Web profile",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": ["lib", "src", "cordis.patch.yml", "README.md"],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "danmaku",
    "meme",
    "subtitle",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoxuejie/dsh-plugin-internet-meme.git"
  },
  "homepage": "https://github.com/zhaoxuejie/dsh-plugin-internet-meme#readme",
  "bugs": {
    "url": "https://github.com/zhaoxuejie/dsh-plugin-internet-meme/issues"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "pnpm run build",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "typecheck:client": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom --skipLibCheck src/bridge.ts"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
